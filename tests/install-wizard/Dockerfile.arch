FROM archlinux:latest
ENV container=docker
ENV DEBIAN_FRONTEND=noninteractive
RUN pacman -Syu --noconfirm systemd sudo curl ca-certificates coreutils socat iproute2 iputils openbsd-netcat nftables \
    && pacman -Scc --noconfirm

RUN systemctl mask getty@tty1.service systemd-firstboot.service systemd-networkd-wait-online.service

COPY dist/tarball/out/lanlink-0.6.1-linux-x86_64.tar.gz /tmp/lanlink.tar.gz
COPY dist/systemd/*.service /tmp/systemd/

CMD ["/usr/lib/systemd/systemd"]
