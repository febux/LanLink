{
  "productName": "LanLink",
  "identifier": "com.lanlink.desktop",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "./assets"
  },
  "app": {
    "windows": [
      {
        "title": "LanLink",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:*; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Native desktop GUI for LanLink",
    "longDescription": "LanLink desktop provides a native cross-platform interface for the LanLink virtual LAN daemon."
  },
  "plugins": {}
}
