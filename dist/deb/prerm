#!/usr/bin/env bash
# prerm: stop running instances before removal.
set -e

case "$1" in
    remove|deconfigure|upgrade)
        systemctl stop 'lanlinkd@*' >/dev/null 2>&1 || true
        systemctl stop lanlink-coordinator.service >/dev/null 2>&1 || true
        systemctl stop lanlink-relayd.service >/dev/null 2>&1 || true
        ;;
esac

exit 0
