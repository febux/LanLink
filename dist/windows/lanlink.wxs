<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <!--
      LanLink Windows MSI (WiX v4/v5).

      Build (see dist/windows/build-msi.sh for the full pipeline):

        wix build -arch x64 dist/windows/lanlink.wxs \
          -d Version=0.1.0 \
          -d BinDir=target/x86_64-pc-windows-msvc/release \
          -d StageDir=dist/windows/stage \
          -d IncludeDesktop=1 \
          -d IncludeWeb=1 \
          -o dist/windows/out/lanlink-0.1.0-x64.msi

      Contents:
        - C:\Program Files\LanLink\            binaries
        - C:\ProgramData\LanLink\            example + default (live) config
        - LanLinkDaemon Windows service      auto-start, LocalSystem
        - Optional Start Menu shortcut for the desktop UI

      The service reads its config from C:\ProgramData\LanLink\lanlinkd.toml
      (hardcoded in crates/lanlinkd/src/service.rs).
    -->
    <Package
        Name="LanLink"
        Manufacturer="LanLink Contributors"
        Version="$(var.Version)"
        Scope="perMachine"
        Language="1033"
        Codepage="1252"
        InstallerVersion="500"
        UpgradeStrategy="majorUpgrade"
        UpgradeCode="3d6b0b6e-7d0e-4c6a-8a7e-9f1a2b3c4d5e">

        <MajorUpgrade DowngradeErrorMessage="A newer version of LanLink is already installed. Uninstall it first or wait for the next release." />
        <MediaTemplate EmbedCab="yes" />

        <Property Id="ARPCOMMENTS" Value="LanLink virtual LAN daemon and GUI (Radmin VPN-style mesh VPN for gaming and remote access)." />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/lanlink/lanlink" />

        <!-- Feature toggles passed in via -d IncludeTui=1 etc. -->
        <Property Id="IncludeTui" Value="0" />
        <Property Id="IncludeWeb" Value="0" />
        <Property Id="IncludeDesktop" Value="0" />

        <!-- Install directory: C:\Program Files\LanLink -->
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLDIR" Name="LanLink">
                <!-- Daemon binary + the Windows service itself.
                     Matches SERVICE_NAME/CONFIG_PATH in service.rs. -->
                <Component Id="LanlinkdExe" Guid="68278cc9-4999-49a0-b543-1ce12fefd9e4">
                    <File Id="lanlinkd.exe" Source="$(var.BinDir)/lanlinkd.exe" KeyPath="yes" />
                    <ServiceInstall
                        Name="LanLinkDaemon"
                        DisplayName="LanLink Virtual LAN Daemon"
                        Description="Cross-platform layer-2 mesh VPN daemon (Radmin VPN-style). Creates the virtual Ethernet adapter and forwards encrypted frames peer-to-peer."
                        Type="ownProcess"
                        Arguments="service run"
                        Start="auto"
                        ErrorControl="normal"
                        Vital="yes" />
                    <ServiceControl
                        Id="LanLinkDaemonControl"
                        Name="LanLinkDaemon"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
                </Component>

                <!-- CLI -->
                <Component Id="LanlinkctlExe" Guid="b7537a6f-5fbd-421b-a696-fa00e9086422">
                    <File Id="lanlinkctl.exe" Source="$(var.BinDir)/lanlinkctl.exe" KeyPath="yes" />
                </Component>

                <!-- Self-host server binaries -->
                <Component Id="LanlinkRelaydExe" Guid="f2e8d3c4-5b7a-4c1d-9e8f-0a1b2c3d4e5f">
                    <File Id="lanlink_relayd.exe" Source="$(var.BinDir)/lanlink-relayd.exe" KeyPath="yes" />
                </Component>
                <Component Id="LanlinkCoordinatorExe" Guid="e1d7c2b3-4a69-3c0e-8d7e-9f0a1b2c3d4e">
                    <File Id="lanlink_coordinator.exe" Source="$(var.BinDir)/lanlink-coordinator.exe" KeyPath="yes" />
                </Component>

                <!-- Wintun driver library (MIT, bundled from https://www.wintun.net/).
                     The driver itself is embedded inside the DLL and installed
                     on first adapter creation. -->
                <Component Id="WintunDll" Guid="fce1e4bb-cf9d-430e-83ce-ec3ed08fe53f">
                    <File Id="wintun.dll" Source="$(var.StageDir)/wintun.dll" KeyPath="yes" />
                </Component>

                <!-- Optional GUI front-ends -->
                <Component Id="LanlinkTuiExe" Guid="a1b2c3d4-e5f6-7890-abcd-ef0123456789" Condition="IncludeTui = 1">
                    <File Id="lanlink_tui.exe" Source="$(var.BinDir)/lanlink-tui.exe" KeyPath="yes" />
                </Component>
                <Component Id="LanlinkWebExe" Guid="b2c3d4e5-f6a7-8901-bcde-f01234567890" Condition="IncludeWeb = 1">
                    <File Id="lanlink_web.exe" Source="$(var.BinDir)/lanlink-web.exe" KeyPath="yes" />
                </Component>
                <Component Id="LanlinkDesktopExe" Guid="c3d4e5f6-a7b8-9012-cdef-012345678901" Condition="IncludeDesktop = 1">
                    <File Id="lanlink_desktop.exe" Source="$(var.BinDir)/lanlink-desktop.exe" KeyPath="yes" />
                </Component>
                <Component Id="LanlinkGuiExe" Guid="d4e5f6a7-b8c9-0123-defa-123456789012" Condition="IncludeTui = 1 OR IncludeWeb = 1 OR IncludeDesktop = 1">
                    <File Id="lanlink_gui.exe" Source="$(var.BinDir)/lanlink-gui.exe" KeyPath="yes" />
                </Component>

                <!-- Add the install dir to the system PATH (last, non-permanent). -->
                <Component Id="PathEnv" Guid="55e0fd95-7770-425d-ae7a-c4a3372e341c">
                    <RegistryValue Root="HKLM"
                                   Key="SYSTEM\CurrentControlSet\Services\LanLinkDaemon"
                                   Name="InstallDir"
                                   Type="string"
                                   Value="[INSTALLDIR]"
                                   KeyPath="yes" />
                    <Environment Id="PathEntry" Name="PATH" Value="[INSTALLDIR]"
                                 Permanent="no" Part="last" Action="set" System="yes" />
                </Component>

                <!-- Docs -->
                <Component Id="Docs" Guid="71b936a3-c1f6-4407-b141-9d8680293593">
                    <File Id="windows_readme.md" Source="dist/windows/README.md" />
                </Component>
            </Directory>
        </StandardDirectory>

        <!-- Config directory: C:\ProgramData\LanLink -->
        <StandardDirectory Id="CommonAppDataFolder">
            <Directory Name="LanLink">
                <!-- Only ever ships the example config; an operator-edited
                     lanlinkd.toml is never touched by install/upgrade/remove. -->
                <Component Id="ExampleConfig" Guid="a865143b-c126-4565-93cc-5324a07b559f">
                    <File Id="lanlinkd.example.toml"
                          Source="dist/lanlinkd.example.toml"
                          KeyPath="yes" />
                </Component>
                <!-- Default live config the service reads
                     (CONFIG_PATH in service.rs). NeverOverwrite keeps
                     operator edits intact across upgrades and repairs;
                     the file is only laid down when absent. -->
                <Component Id="LiveConfig" Guid="d41c8f22-9b53-4e77-8a10-6c2f1d0b7a94" NeverOverwrite="yes">
                    <File Id="lanlinkd.toml"
                          Source="dist/windows/lanlinkd.toml"
                          KeyPath="yes" />
                    <RemoveFile Id="RemoveLiveConfig"
                                Name="lanlinkd.toml"
                                On="uninstall" />
                </Component>
            </Directory>
        </StandardDirectory>

        <!-- Start Menu shortcut for the desktop UI -->
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Name="LanLink">
                <Component Id="DesktopShortcut" Guid="e5f6a7b8-c9d0-1234-efab-234567890123" Condition="IncludeDesktop = 1">
                    <Shortcut Id="LanLinkDesktopShortcut"
                              Name="LanLink"
                              Target="[INSTALLDIR]lanlink-desktop.exe"
                              WorkingDirectory="INSTALLDIR"
                              Description="LanLink virtual LAN desktop UI" />
                    <RegistryValue Root="HKLM"
                                   Key="Software\LanLink"
                                   Name="installed"
                                   Type="integer"
                                   Value="1"
                                   KeyPath="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <Feature Id="Core" Title="LanLink Core" Level="1" AllowAdvertise="no" Display="expand">
            <ComponentRef Id="LanlinkdExe" />
            <ComponentRef Id="LanlinkctlExe" />
            <ComponentRef Id="LanlinkRelaydExe" />
            <ComponentRef Id="LanlinkCoordinatorExe" />
            <ComponentRef Id="WintunDll" />
            <ComponentRef Id="PathEnv" />
            <ComponentRef Id="Docs" />
            <ComponentRef Id="ExampleConfig" />
            <ComponentRef Id="LiveConfig" />

            <Feature Id="TuiFeature" Title="Terminal UI" Level="1" AllowAdvertise="no">
                <ComponentRef Id="LanlinkTuiExe" />
            </Feature>
            <Feature Id="WebFeature" Title="Browser WebUI" Level="1" AllowAdvertise="no">
                <ComponentRef Id="LanlinkWebExe" />
            </Feature>
            <Feature Id="DesktopFeature" Title="Desktop UI" Level="1" AllowAdvertise="no">
                <ComponentRef Id="LanlinkDesktopExe" />
                <ComponentRef Id="DesktopShortcut" />
            </Feature>
            <Feature Id="GuiLauncherFeature" Title="Unified GUI Launcher" Level="1" AllowAdvertise="no">
                <ComponentRef Id="LanlinkGuiExe" />
            </Feature>
        </Feature>

        <!-- Fail fast with a readable message if the service exe goes missing. -->
        <Property Id="ARPNOMODIFY" Value="1" />
    </Package>
</Wix>
